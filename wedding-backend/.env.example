# Put real values in Vercel Environment Variables; never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_PASSWORD=replace-with-a-strong-unique-password
TOKEN_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173

# Keep this unique per wedding website even when DATABASE_URL is shared.
WEDDING_ID=heena-bride-side
